{
  "name": "@continuum/vscode-collector",
  "displayName": "Continuum",
  "description": "Privacy-first VS Code activity metadata collector for Continuum.",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20"
  },
  "main": "./dist/src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:continuum.setToken",
    "onCommand:continuum.flushQueue"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "continuum.setToken",
        "title": "Continuum: Connect to Local Engine"
      },
      {
        "command": "continuum.flushQueue",
        "title": "Continuum: Retry Pending Events"
      }
    ],
    "configuration": {
      "title": "Continuum",
      "properties": {
        "continuum.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:43117",
          "description": "Fixed loopback origin of the Continuum engine. Only port 43117 is accepted."
        },
        "continuum.captureEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Capture sanitized workspace focus, active-file, and save metadata."
        },
        "continuum.projectId": {
          "type": "string",
          "default": "",
          "format": "uuid",
          "description": "Optional existing global project UUID. Empty lets Continuum match clones from their root commit and normalized repository name."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "verify": "npm run test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.8.0"
  }
}
