{
  "manifest_version": 3,
  "name": "Continuum Context Collector",
  "description": "Sends sanitized metadata for the foreground allowlisted tab to the local Continuum engine.",
  "version": "0.2.0",
  "minimum_chrome_version": "114",
  "incognito": "not_allowed",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:43117/*",
    "http://localhost:43117/*"
  ],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Continuum",
    "default_popup": "popup.html"
  }
}
